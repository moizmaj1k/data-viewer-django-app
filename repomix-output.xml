}

.mlp-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #4b5563;
}

.mlp-close {
  border: 0;
  background: transparent;
  font-size: 16px;
  line-height: 1;
  padding: 2px 4px;
  cursor: pointer;
