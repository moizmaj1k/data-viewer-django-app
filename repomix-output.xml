/* Compact horizontal bar chart for counts */
.bar-chart{ display: grid; gap: 8px; }
.bar-row{display:block}
.bar-label{ font-size: 12px; color: #374151; margin-bottom: 2px; }
.bar-track{
  position:relative;
  height:14px;                     /* a bit slimmer to save vertical space */
  border-radius:10px;               /* rounder edges */
  background:#eef2f7;
  max-width:100%;
  overflow:hidden;                  /* avoid any horizontal scrollbar */
  padding-right:38px;               /* reserve space for the value label */
}
.bar-fill{
  position:absolute;inset:0 auto 0 0;width:0%;
  border-radius:10px;               /* keep same rounding on the fill */
  background:#3b82f6
}
.bar-value{
  position:absolute;right:8px;top:50%;transform:translateY(-50%);
  font-size:12px;color:#000;font-weight:700;
}

/* Road / Asset image gallery */
/* Bigger 2-up image gallery in the drawer */
.gallery{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:12px
}
.gallery a{
  display:block;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;background:#fff
}
.gallery img{
  display:block;width:100%;height:200px;object-fit:cover
}

/* ---------- Image Lightbox ---------- */
.imglightbox{
  position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.6);
  display:flex;align-items:center;justify-content:center
}
.imglightbox[hidden]{display:none}
.imglightbox__panel{
  position:relative;background:#111;border-radius:12px;max-width:92vw;max-height:88vh;
  display:flex;flex-direction:column;gap:8px;padding:10px
}
.imglightbox__stage{
  position:relative;background:#000;overflow:hidden;border-radius:8px;display:flex;align-items:center;justify-content:center
}
.imglightbox__img{max-width:100%;max-height:74vh;transform-origin:center center;transition:transform .15s ease}
.imglightbox__tools{display:flex;gap:8px;justify-content:flex-end}
.imglightbox__btn{border:1px solid #374151;background:#1f2937;color:#fff;border-radius:8px;padding:6px 10px;cursor:pointer}
.imglightbox__btn:hover{background:#111827}


/* MAP MEASURE TOOL */

.map-tool {
  position: relative;
}

/* Reuse global .btn/.btn-outline look; just tweak sizing */
.map-tool-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5px 10px;    /* similar to Add Layer / Marker */
  font-size: 12px;
  gap: 4px;
  line-height: 1;
}

.map-tool-btn:focus {
  outline: 2px solid #3b82f6;
  outline-offset: 1px;
}

/* Dropdown: compact + small font */
.map-tool-dropdown {
  position: absolute;
  top: calc(100% + 4px);   /* just below the Measurement button */
  left: 0;
  z-index: 50;             /* above filters panel content */
  padding: 6px;
  border-radius: 6px;
  border: 1px solid #d0d4db;
  background: #ffffff;
  font-size: 11px;
  margin-top: 0;           /* ensure it doesn’t push layout */
}

.map-tool-dropdown.is-hidden {
  display: none;
}

.map-measure-row {
  margin-bottom: 4px;
}

.map-measure-label {
  display: block;
  font-weight: 500;
  margin-bottom: 2px;
  font-size: 11px;
}

.map-measure-select {
  width: 100%;
  padding: 3px 6px;
  font-size: 11px;
  border-radius: 6px;
  border: 1px solid #cfd3d8;
}

.map-measure-checkbox {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
}

.map-measure-actions {
  display: flex;
  gap: 6px;
}

/* Buttons inside dropdown: compact, similar feel to other btns */
.map-measure-btn {
  flex: 1;
  padding: 3px 6px;
  font-size: 11px;
  border-radius: 6px;
  border: 1px solid #d0d4db;
  background: #f3f4f8;
  cursor: pointer;
  line-height: 1.2;
}

.map-measure-btn[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}

.map-measure-btn--primary {
  background: #2563eb;
  color: #ffffff;
  border-color: #1d4ed8;
}

.map-measure-btn--danger {
  width: 100%;
  background: #fee2e2;
  color: #991b1b;
  border-color: #fecaca;
}
