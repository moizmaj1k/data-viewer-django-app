}

/* Shared styles for layer / marker lists in the Map Items panel */
.map-layers-panel .layer-toggles,
.map-layers-panel .marker-toggles {
  max-height: 90px;
  overflow-y: auto;
  border-radius: 4px;
  border: 1px solid #e5e7eb;
  padding: 4px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

/* Row wrappers */
.map-layers-panel .marker-row,
.map-layers-panel .layer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

/* Group action buttons tight on the right (edit / center / delete) */
.marker-row-actions,
.layer-row-actions {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

/* Clickable label (toggle + name) */
.map-layers-panel .marker-toggle,
.map-layers-panel .layer-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  font-size: 11px;
  padding: 3px 4px;
  border-radius: 4px;
}

.map-layers-panel .marker-toggle:hover,
.map-layers-panel .layer-toggle:hover {
  background: #f9fafb;
}

/* Hide the native checkbox; we use the pill as the visible control */
.map-layers-panel .marker-toggle input[type="checkbox"],
.map-layers-panel .layer-toggle input[type="checkbox"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

/* Tiny rectangular toggle pill */
.toggle-pill {
  width: 24px;
  height: 14px;
  border-radius: 3px;
  border: 1px solid #d1d5db;
  background: #f3f4f6;
  position: relative;
  flex-shrink: 0;
  transition:
    background var(--fx-fast) var(--fx-ease),
    border-color var(--fx-fast) var(--fx-ease);
}

.toggle-pill::after {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: 8px;
  height: 8px;
  border-radius: 2px;
  background: #9ca3af;
  transition:
    transform var(--fx-fast) var(--fx-ease),
    background var(--fx-fast) var(--fx-ease);
}

.toggle-pill.is-on {
  background: #2563eb;
  border-color: #2563eb;
}

.toggle-pill.is-on::after {
  transform: translateX(10px);
  background: #ffffff;
}


/* Icon + name text */
.map-layers-panel .marker-name,
.map-layers-panel .layer-name {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Inject emoji icons before the text, just like before */
.map-layers-panel .marker-name::before {
  content: "📍";
}

.map-layers-panel .layer-name::before {
  content: "🗺️";
}

.marker-row.is-editing {
  background: #fef2f2; /* soft reddish highlight */
  border-radius: 4px;
}

/* Pill shows "editing" state when row is editing */
.marker-row.is-editing .marker-toggle-pill {
  background: #fee2e2;
  border-color: #ef4444;
  width: auto;
  min-width: 60px;
}

.marker-row.is-editing .marker-toggle-pill::after {
  display: none; /* hide the little knob */
}

.marker-row.is-editing .marker-toggle-pill::before {
  content: "editing";
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
  color: #b91c1c;
